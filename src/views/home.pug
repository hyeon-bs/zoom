doctype html
html(lang="ko")
    head
        meta(charset="UTF-8")
        meta(name="viewport", content="width=device-width, initial-scale=1.0")
        title Zoom Video Chat
        link(rel="preconnect" href="https://fonts.googleapis.com")
        link(rel="preconnect" href="https://fonts.gstatic.com" crossorigin)
        link(rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap")
        link(rel="stylesheet" href="/public/css/style.css")

    body

        //- =============================================
        //- PAGE 1: ROOM ENTRY VIEW
        //- =============================================
        div#welcome.page-welcome
            div.entry-card
                div.entry-header
                    h1.entry-title Zoom Video Chat
                    p.entry-subtitle Enter a room name and nickname to join

                form.entry-form
                    div.form-group
                        label(for="roomInput") Room Name
                        input#roomInput(
                            type="text"
                            placeholder="e.g. dev-meeting"
                            required
                            autocomplete="off"
                        )
                    div.form-group
                        label(for="nicknameInput") Nickname
                        input#nicknameInput(
                            type="text"
                            placeholder="e.g. Alex"
                            required
                            autocomplete="off"
                        )
                    button.btn-primary(type="submit") Enter Room

                div.open-rooms
                    h4.open-rooms-title Open Rooms
                    ul.room-list


        //- =============================================
        //- PAGE 2: VIDEO MEETING + CHAT VIEW
        //- =============================================
        div#call.page-call(style="display:none")

            //- ---- Left: Video Area ----
            div.video-area

                div.video-viewport

                    //- View mode switcher (top-right overlay)
                    div.view-mode-bar
                        button.view-btn.active(data-mode="remote-main") Remote Main
                        button.view-btn(data-mode="local-main") Local Main
                        button.view-btn(data-mode="split") 50/50 Split

                    //- Video container
                    div#videoContainer.video-container.mode-remote-main

                        div#peerSlot.video-slot
                            video#peerFace(autoplay playsinline)
                            span#peerBadge.name-badge Peer

                        div#mySlot.video-slot
                            video#myFace(autoplay playsinline muted)
                            span#myBadge.name-badge You

                    //- Control bar (pill, bottom-center overlay)
                    div.control-bar

                        //- Mute Mic
                        button#mute.ctrl-btn(title="Toggle Microphone")
                            svg(xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round")
                                path(d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z")
                                path(d="M19 10v2a7 7 0 0 1-14 0v-2")
                                line(x1="12" y1="19" x2="12" y2="23")
                                line(x1="8" y1="23" x2="16" y2="23")

                        //- Toggle Camera
                        button#camera.ctrl-btn(title="Toggle Camera")
                            svg(xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round")
                                polygon(points="23 7 16 12 23 17 23 7")
                                rect(x="1" y="5" width="15" height="14" rx="2" ry="2")

                        div.separator

                        //- Camera Select
                        select#cameras.camera-select

                        div.separator

                        //- Leave Room
                        button#leaveRoom.ctrl-btn.ctrl-btn--leave(title="Leave Room")
                            svg(xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round")
                                path(d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4")
                                polyline(points="16 17 21 12 16 7")
                                line(x1="21" y1="12" x2="9" y2="12")


            //- ---- Right: Chat Sidebar ----
            div.chat-sidebar
                div#room
                    div.chat-header
                        div.chat-header-left
                            span.chat-title Room Chat
                            span#roomLabel.room-label
                        span.chat-toggle-icon
                            svg(xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round")
                                polyline(points="18 15 12 9 6 15")

                    ul.message-list

                    form#msg.chat-input-form
                        input.chat-input(
                            type="text"
                            placeholder="Message..."
                            required
                            autocomplete="off"
                        )
                        button.chat-send-btn(type="submit") Send


        script(src="/socket.io/socket.io.js")
        script.
            window.turnConfig = {
                urls: "#{turnUrl}",
                username: "#{turnUsername}",
                credential: "#{turnCredential}"
            }
        script(src="/public/js/app.js")
